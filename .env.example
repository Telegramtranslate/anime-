# Строка подключения PostgreSQL — нужна только для «Избранного» и «Истории».
# Без неё сайт работает полностью, но без персональных коллекций.
# Локально поднять БД: см. db/README в README.md (docker run ... postgres:16).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Личный токен Kodik (необязательно). Без него сайт сам берёт рабочие
# публичные токены из списка и проверяет их.
# KODIK_TOKEN=

# Принудительный демо-режим без обращения к Kodik (0/1). В проде не трогать:
# демо включается сам и только если API недоступен по сети.
# ANIVERSE_DEMO=
